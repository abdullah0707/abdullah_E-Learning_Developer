{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio-backend",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-15",
  "assets": {
    "directory": "./admin-ui",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin/api/*", "/preview/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio",
      "database_id": "784e18a7-3f64-4507-8052-6f84ae7cc369",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "SAMPLES_BUCKET", "bucket_name": "portfolio-assets" }
  ],
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "PREVIEW_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
